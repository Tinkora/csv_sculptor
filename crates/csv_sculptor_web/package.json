{
  "name": "csv_sculptor_web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir static/pkg .",
    "prepare:wasm-smoke": "node scripts/prepare_wasm_smoke.mjs",
    "serve": "http-server . -a 127.0.0.1 -p 4173 -c-1 --silent",
    "test:wasm-smoke": "npm run prepare:wasm-smoke && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "14.1.1"
  }
}
