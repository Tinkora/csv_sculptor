{
  "name": "csv_sculptor",
  "version": "1",
  "description": "Registered tools for the local csv_sculptor_mcp stdio server.",
  "transport": {
    "type": "stdio",
    "command": "csv_sculptor_mcp",
    "network": "none",
    "max_input_bytes": 10485760,
    "max_message_bytes": 67108864
  },
  "output_envelope": {
    "schema_version": "1",
    "required": ["schema_version", "tool", "data"]
  },
  "tools": [
    {
      "name": "csv_sculptor_parse",
      "description": "Parse bounded UTF-8 CSV/TSV text into a structured table. Auto-detects comma, tab, pipe, or semicolon delimiters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw UTF-8 CSV/TSV text, no larger than 10 MiB."
          },
          "has_header": {
            "type": "boolean",
            "default": true,
            "description": "Treat the first row as headers."
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    },
    {
      "name": "csv_sculptor_filter",
      "description": "Filter a structured table with AND-combined conditions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": { "$ref": "#/$defs/TableInput" },
          "conditions": {
            "type": "array",
            "items": { "$ref": "#/$defs/FilterCondition" }
          }
        },
        "required": ["table", "conditions"],
        "additionalProperties": false,
        "$defs": {
          "TableInput": {
            "type": "object",
            "properties": {
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
              "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
              "row_count": { "type": "integer", "minimum": 0 }
            },
            "required": ["headers", "rows", "delimiter", "row_count"],
            "additionalProperties": false
          },
          "FilterCondition": {
            "type": "object",
            "properties": {
              "column": { "type": "string" },
              "operator": {
                "type": "string",
                "enum": ["Equals", "NotEquals", "Contains", "StartsWith", "EndsWith", "GreaterThan", "LessThan", "IsEmpty", "IsNotEmpty"]
              },
              "value": { "type": "string", "default": "" }
            },
            "required": ["column", "operator"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "csv_sculptor_sort",
      "description": "Sort a structured table by one column, numerically when possible and otherwise case-insensitive text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": { "$ref": "#/$defs/TableInput" },
          "column": { "type": "string" },
          "ascending": { "type": "boolean", "default": true }
        },
        "required": ["table", "column"],
        "additionalProperties": false,
        "$defs": {
          "TableInput": {
            "type": "object",
            "properties": {
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
              "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
              "row_count": { "type": "integer", "minimum": 0 }
            },
            "required": ["headers", "rows", "delimiter", "row_count"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "csv_sculptor_export",
      "description": "Export a structured table to deterministic JSON, YAML, Markdown, SQL, CSV, or TSV text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": { "$ref": "#/$defs/TableInput" },
          "format": { "type": "string", "enum": ["json", "yaml", "markdown", "sql", "csv", "tsv"] },
          "table_name": { "type": "string", "default": "table_name" }
        },
        "required": ["table", "format"],
        "additionalProperties": false,
        "$defs": {
          "TableInput": {
            "type": "object",
            "properties": {
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
              "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
              "row_count": { "type": "integer", "minimum": 0 }
            },
            "required": ["headers", "rows", "delimiter", "row_count"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "csv_sculptor_detect_delimiter",
      "description": "Detect the delimiter used in bounded UTF-8 CSV/TSV text without returning a table.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw UTF-8 CSV/TSV text to inspect."
          }
        },
        "required": ["input"],
        "additionalProperties": false
      }
    }
  ]
}
